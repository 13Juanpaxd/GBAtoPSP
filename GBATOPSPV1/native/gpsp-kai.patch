+u32 quick_settings_menu(u16 *original_screen)
+{
+  static const char *ratio_names[] = { "4:3", "16:9" };
+  static const char *filter_names[] = { "Sin filtro", "Bilineal" };
+  static const char *frameskip_names[] = { "Auto", "Manual", "Sin salto" };
