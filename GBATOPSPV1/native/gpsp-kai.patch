+    gamepad_config_map[9] = BUTTON_ID_RIGHT;
+    gamepad_config_map[12] = BUTTON_ID_UP;
+    gamepad_config_map[13] = BUTTON_ID_DOWN;
+    gamepad_config_map[14] = BUTTON_ID_LEFT;
+    gamepad_config_map[15] = BUTTON_ID_RIGHT;
+  }
+
+  void draw_tab_bar()
+  {
+    sprintf(line, "< L   %s   R >", tab_names[tab]);
+    PRINT_STRING_BG(line, COLOR_ACTIVE_ITEM, COLOR_BG, 145, 20);
+    PRINT_STRING_BG("L/R: pestaÃ±as", COLOR_HELP_TEXT, COLOR_BG, 12, 20);
+  }
+
+  const char *mapping_name(u32 value)
+  {
+    for(u32 i = 0; i < 8; i++) if(map_values[i] == value) return map_names[i];
+    return value == BUTTON_ID_MENU ? "Menu" : "Ninguno";
+  }
+
+  pause_sound(1);
+  /* Do not reuse gpSP's global input state here.  It belongs to gameplay and
+     caused the first menu read to consume a stale direction or analog value. */
+  do
+  {
+    sceCtrlPeekBufferPositive(&ctrl_data, 1);
+    sceKernelDelayThread(20000);
+  } while(ctrl_data.Buttons & (PSP_CTRL_SELECT | PSP_CTRL_START));
+  video_resolution(FRAME_MENU);
+  enforce_direction_mapping();
+  while(running)
+  {
+    clear_screen(COLOR_BG);
+    blit_to_screen(original_screen, 240, 160, 230, 40);
+    draw_tab_bar();
+    if(tab == 0)
+    {
+      PRINT_STRING_BG("Configuracion rapida", COLOR_ACTIVE_ITEM, COLOR_BG, 12, 45);
+      sprintf(line, "Relacion de aspecto: %s", ratio_names[g_gpsp_config.screen_ratio]);
+      PRINT_STRING_BG(line, selected == 0 ? COLOR_ACTIVE_ITEM : COLOR_INACTIVE_ITEM, COLOR_BG, 12, 65);
+      sprintf(line, "Salto de cuadros: %s", frameskip_names[g_game_config.frameskip_type]);
+      PRINT_STRING_BG(line, selected == 1 ? COLOR_ACTIVE_ITEM : COLOR_INACTIVE_ITEM, COLOR_BG, 12, 85);
+      sprintf(line, "Limite de salto: %d", (int)g_game_config.frameskip_value);
+      PRINT_STRING_BG(line, selected == 2 ? COLOR_ACTIVE_ITEM : COLOR_INACTIVE_ITEM, COLOR_BG, 12, 105);
+      sprintf(line, "Filtro: %s", filter_names[g_gpsp_config.screen_filter]);
+      PRINT_STRING_BG(line, selected == 3 ? COLOR_ACTIVE_ITEM : COLOR_INACTIVE_ITEM, COLOR_BG, 12, 125);
+      sprintf(line, "CPU clock: %s MHz", clock_names[g_game_config.clock_speed_number]);
+      PRINT_STRING_BG(line, selected == 4 ? COLOR_ACTIVE_ITEM : COLOR_INACTIVE_ITEM, COLOR_BG, 12, 145);
+      sprintf(line, "Avance rapido: %s", fast_names[g_synchronize_flag ? 0 : 1]);
+      PRINT_STRING_BG(line, selected == 5 ? COLOR_ACTIVE_ITEM : COLOR_INACTIVE_ITEM, COLOR_BG, 12, 165);
+    }
+    else if(tab == 1)
+    {
+      PRINT_STRING_BG("Save states", COLOR_ACTIVE_ITEM, COLOR_BG, 12, 45);
+      sprintf(line, "Ranura: %d", (int)g_savestate_slot_num);
+      PRINT_STRING_BG(line, selected == 0 ? COLOR_ACTIVE_ITEM : COLOR_INACTIVE_ITEM, COLOR_BG, 12, 75);
+      PRINT_STRING_BG("Guardar estado", selected == 1 ? COLOR_ACTIVE_ITEM : COLOR_INACTIVE_ITEM, COLOR_BG, 12, 105);
+      PRINT_STRING_BG("Cargar estado", selected == 2 ? COLOR_ACTIVE_ITEM : COLOR_INACTIVE_ITEM, COLOR_BG, 12, 135);
+      PRINT_STRING_BG("START + R: cargar", COLOR_HELP_TEXT, COLOR_BG, 12, 165);
+      PRINT_STRING_BG("SELECT + L: guardar", COLOR_HELP_TEXT, COLOR_BG, 12, 180);
+    }
+    else
+    {
+      PRINT_STRING_BG("Mapeado de botones", COLOR_ACTIVE_ITEM, COLOR_BG, 12, 45);
+      for(u32 i = 0; i < 8; i++)
+      {
+        sprintf(line, "%s: %s", button_names[i], mapping_name(gamepad_config_map[button_indexes[i]]));
+        PRINT_STRING_BG(line, selected == i ? COLOR_ACTIVE_ITEM : COLOR_INACTIVE_ITEM, COLOR_BG, 12, 65 + i * 17);
+      }
+      PRINT_STRING_BG("Analogico y cruceta: direcciones", COLOR_HELP_TEXT, COLOR_BG, 12, 210);
+    }
+    PRINT_STRING_BG("Arriba/abajo: elegir   Izq/der: cambiar", COLOR_HELP_TEXT, COLOR_BG, 12, 235);
+    PRINT_STRING_BG("Start, Select o cuadrado: volver", COLOR_HELP_TEXT, COLOR_BG, 12, 250);
+    flip_screen();
+    sceCtrlPeekBufferPositive(&ctrl_data, 1);
+    {
+      u32 buttons = ctrl_data.Buttons;
+      u32 pressed = buttons & ~previous_buttons;
+      previous_buttons = buttons;
+      u32 count = tab == 0 ? 6 : tab == 1 ? 3 : 8;
+      if(pressed & PSP_CTRL_LTRIGGER)
+      {
+        tab = tab ? tab - 1 : 2;
+        selected = 0;
+      }
+      else if(pressed & PSP_CTRL_RTRIGGER)
+      {
+        tab = (tab + 1) % 3;
+        selected = 0;
+      }
+      else if(pressed & PSP_CTRL_UP) selected = selected ? selected - 1 : count - 1;
+      else if(pressed & PSP_CTRL_DOWN) selected = (selected + 1) % count;
+      else if(pressed & (PSP_CTRL_LEFT | PSP_CTRL_RIGHT))
+      {
+        s32 direction = (pressed & PSP_CTRL_LEFT) ? -1 : 1;
+        if(tab == 0)
+        {
+          switch(selected)
+          {
+            case 0: g_gpsp_config.screen_ratio = (g_gpsp_config.screen_ratio + 2 + direction) % 2; break;
+            case 1: g_game_config.frameskip_type = (g_game_config.frameskip_type + 3 + direction) % 3; break;
+            case 2: g_game_config.frameskip_value = (g_game_config.frameskip_value + 10 + direction) % 10; break;
+            case 3: g_gpsp_config.screen_filter = (g_gpsp_config.screen_filter + 2 + direction) % 2; break;
+            case 4: g_game_config.clock_speed_number = (g_game_config.clock_speed_number + 10 + direction) % 10; set_cpu_clock(g_game_config.clock_speed_number); break;
+            case 5: g_synchronize_flag ^= 1; break;
+          }
+        }
+        else if(tab == 1 && selected == 0)
+          g_savestate_slot_num = (g_savestate_slot_num + 10 + direction) % 10;
+        else if(tab == 2)
+        {
+          u32 index = button_indexes[selected];
+          u32 value = gamepad_config_map[index];
+          u32 found = 0;
+          for(u32 i = 0; i < 8; i++) if(map_values[i] == value) found = i;
+          gamepad_config_map[index] = map_values[(found + 8 + direction) % 8];
+          g_game_config.use_default_gamepad_map = NO;
+          enforce_direction_mapping();
+        }
+      }
+      else if(tab == 1 && (pressed & (PSP_CTRL_CROSS | PSP_CTRL_CIRCLE)))
+      {
+        char filename[MAX_FILE];
+        get_savestate_filename_noshot(g_savestate_slot_num, filename);
+        if(selected == 1) save_state(filename, original_screen, g_savestate_slot_num);
+        if(selected == 2 && load_state(filename, g_savestate_slot_num) == 1) { result = 1; running = 0; }
+      }
+      else if(pressed & (PSP_CTRL_START | PSP_CTRL_SELECT | PSP_CTRL_SQUARE | PSP_CTRL_CROSS | PSP_CTRL_CIRCLE))
+        running = 0;
+    }
+    sceKernelDelayThread(20000);
+  }
+  save_config_file();
+  save_game_config_file();
+  button_up_wait();
+  clear_screen(0);
+  flip_screen();
+  video_resolution(FRAME_GAME);
+  set_cpu_clock(g_game_config.clock_speed_number);
+  pause_sound(0);
+  real_frame_count = 0;
+  virtual_frame_count = 0;
+  return result;
+}
